    "server:test": "npm --prefix server run test",
    "server:seed": "npm --prefix server run prisma:seed",
    "test:all": "vitest run && npm --prefix server run test"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
