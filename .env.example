# ==============================================================================
# VECTORLY FULL-STACK ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Backend Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vectorly_db?schema=public

# Authentication & Security Secrets
JWT_ACCESS_SECRET=vectorly_dev_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=vectorly_dev_jwt_refresh_secret_super_secure_key_67890
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=vectorly_cookie_secret_key_99999

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Optional: Google Gemini AI Design Copilot
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
